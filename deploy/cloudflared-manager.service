[Unit]
Description=Cloudflared Manager
Documentation=https://github.com/llit47/cloudflared-manager
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cloudflared-manager
Group=cloudflared-manager
EnvironmentFile=/etc/cloudflared-manager/cloudflared-manager.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/cloudflared-manager/current
# PR14's updater installs this unit before its first PR15 restart. The fixed
# root bootstrap runs in a separate transient service, never in the web mount.
ExecStartPre=!/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C /usr/bin/systemd-run --system --pipe --wait --quiet --collect --service-type=exec --property=ProtectSystem=strict "--property=ReadWritePaths=/etc/tmpfiles.d /run" --property=NoNewPrivileges=yes --property=UMask=0077 --property=CapabilityBoundingSet=CAP_CHOWN --property=RuntimeMaxSec=30s --property=Environment=PYTHONDONTWRITEBYTECODE=1 /opt/cloudflared-manager/current/.venv/bin/python -I -m cloudflared_manager.deployment.runtime_bootstrap
ExecStart=/opt/cloudflared-manager/current/.venv/bin/cloudflared-manager
Restart=on-failure
RestartSec=5s
UMask=0077

NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
# PR14 reads /proc/<MainPID>/environ for a possibly different cloudflared UID.
# Linux applies a ptrace read check there; root recovery needs CAP_SYS_PTRACE.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID CAP_SYS_PTRACE
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
