# Safe local-development examples. Copy to .env and export these values in
# your shell if desired; the application does not load .env files itself.
CFM_APP_NAME="Cloudflared Manager"
CFM_MODE=development
CFM_BIND_HOST=127.0.0.1
CFM_BIND_PORT=8000
CFM_CLOUDFLARED_CONFIG_PATH=tests/fixtures/cloudflared/config.yml
